{
  "name": "owl-support-processor",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "SUPPORT_DB",
      "database_name": "owl-support-cases",
      "database_id": "ddcc953e-4ce4-4513-b802-c61729b84554"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "owl-mailer"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
