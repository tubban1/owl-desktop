{
  "manifest_version": 3,
  "name": "OWL LAB Agent Browser",
  "version": "0.2.0",
  "description": "Agent-owned background Chrome tabs through a local Native Messaging host; requires explicit Chrome extension permissions.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "OWL LAB Agent Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
